# ── LiveKit ─────────────────────────────────────────────────────────────
# Create a project at https://cloud.livekit.io (or self-host)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Providers ───────────────────────────────────────────────────────────
DEEPGRAM_API_KEY=
ELEVEN_API_KEY=
INWORLD_API_KEY=
XAI_API_KEY=

# ── Telephony (real numbers, calls, SMS) ────────────────────────────────
# Optional here — telephony is normally turned on from Studio > Telephony >
# Settings (credentials are stored in the database). PUBLIC_BASE_URL is the one
# thing that must be a real, reachable URL for INBOUND calls and texts: Twilio
# posts webhooks to it. On localhost, inbound cannot arrive until you deploy to
# a public host or expose the API with a tunnel (ngrok/cloudflared).
PUBLIC_BASE_URL=http://localhost:8000
# Calls are bridged into the agent over LiveKit SIP (uses LIVEKIT_* above).
# Providers: Telnyx (free credit to start) or Twilio. Pick one in Studio,
# Telephony, Settings and paste its credentials there.

# ── Models ──────────────────────────────────────────────────────────────
# Realtime voice loop: latency-first. Deep agent / judge: quality-first.
XAI_REALTIME_MODEL=grok-3-mini
XAI_AGENT_MODEL=grok-4
XAI_JUDGE_MODEL=grok-4

# ── LLM provider override (optional) ────────────────────────────────────
# The voice agent uses xAI Grok by default. To use ANY OpenAI-compatible LLM
# instead, set these three (they take precedence over XAI_* above), then
# `docker compose up -d --force-recreate agent`.
#
# ▶ GROQ — FREE and the best fit for voice (fastest first-token latency).
#   Get a free key at https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
#
# ▶ Google Gemini — also has a free tier:
#LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#LLM_API_KEY=
#LLM_MODEL=gemini-2.0-flash
#
# ▶ OpenAI (paid):
#LLM_BASE_URL=https://api.openai.com/v1
#LLM_API_KEY=sk-...
#LLM_MODEL=gpt-4o-mini

# ── Voice pipeline tuning (read by apps/agent) ──────────────────────────
STT_MODEL=nova-3
STT_LANGUAGE=multi                # "multi" = Deepgram multilingual code-switching
TTS_VOICE_ID=EXAVITQu4vr4xnSDxMaL # ElevenLabs voice id
TTS_MODEL=eleven_flash_v2_5       # flash = ~75ms model latency; turbo = better quality
VAD_MIN_SILENCE=0.40              # seconds of silence before candidate end-of-turn
VAD_ACTIVATION_THRESHOLD=0.55     # raise in noisy environments
MIN_ENDPOINTING_DELAY=0.40        # floor for end-of-utterance wait
MAX_ENDPOINTING_DELAY=6.0         # cap when turn-detector says "still talking"
MIN_INTERRUPTION_DURATION=0.55    # speech length that counts as a barge-in
ALLOW_INTERRUPTIONS=true

# ── SIP / telephony (optional — needed for real call transfers) ─────────
SIP_TRANSFER_NUMBER=              # e.g. tel:+15550001234 (cold transfer target)
SIP_SUPERVISOR_NUMBER=            # warm transfer target
SIP_OUTBOUND_TRUNK_ID=            # LiveKit SIP trunk id

# ── Services ────────────────────────────────────────────────────────────
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
BACKEND_URL=http://127.0.0.1:8000

# ── Auth ────────────────────────────────────────────────────────────────
# Sign the session JWTs — set a long random string in production.
AUTH_SECRET=dev-insecure-change-me
# DEV_MODE=true returns OTP / password-reset codes in API responses so you can
# test signup + reset without an email provider. Set false once email is wired.
DEV_MODE=true
FRONTEND_URL=http://localhost:3000

# Google Sign-In (optional — the button stays inactive until these are set).
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# "Book a demo" button target on the landing page (Google Calendar / Calendly).
CALENDAR_URL=

# ── Docker deploys ──────────────────────────────────────────────────────
# URL the BROWSER uses to reach the API (defaults to http://localhost:8000).
# Set when hosting on a real domain, and add the web origin to CORS_ORIGINS.
#PUBLIC_API_URL=https://api.yourdomain.com
#CORS_ORIGINS=http://localhost:3000,https://app.yourdomain.com

# ── Web (apps/web/.env.local) ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
