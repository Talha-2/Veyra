# The voice worker's settings. setup.sh copies this to /opt/veyra/voice.env;
# fill that copy in (never commit it), then run setup.sh again.

# LiveKit Cloud project: the same three values veyra-app has on Render.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# The app on Render, e.g. https://veyra-app.onrender.com (no trailing slash).
APP_LAYER_URL=
# Copy it from Render: veyra-app -> Environment -> AGENT_SHARED_SECRET.
AGENT_SHARED_SECRET=

# Speech to text.
DEEPGRAM_API_KEY=
# The talker and worker models.
OPENAI_API_KEY=
# Voices: at least one. ElevenLabs on a free plan can use only its default voices.
ELEVEN_API_KEY=
CARTESIA_API_KEY=

# Optional: traces in Langfuse.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Processes kept warm for the next call. One is enough for a demo.
VOICE_IDLE_PROCESSES=1
# 1 on a ~1 GB host (Oracle's free E2.1.Micro): calls share one process and
# the turn-detector model is skipped. Leave 0 on anything with 4 GB or more.
VOICE_LOW_MEMORY=0
# End-of-turn model: "audio" (default; local, in-process, ~0.1 s per
# prediction, ~0.5 s end-of-turn measured) or "text" (the older multilingual
# transcript model in its own process; ~0.3-0.9 s per prediction).
VOICE_TURN_DETECTOR=audio
# 1 also synthesises speech for the preemptive draft before the turn is
# confirmed: a little faster first audio, but discarded drafts are billed.
VOICE_PREEMPTIVE_TTS=0
